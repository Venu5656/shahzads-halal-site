# ---------------------------------------------------------------------------
# Copy to .env.local (Next.js) / .env (Prisma CLI) and fill in.
# NEVER commit a filled-in copy of this file.
# ---------------------------------------------------------------------------

# Postgres — matches docker-compose.yml for local development.
DATABASE_URL="postgresql://shahzad:shahzad@localhost:5432/shahzads?schema=public"

# Public base URL of the site (used for callbacks and absolute links).
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Ordering ----------------------------------------------------------------
# REQUIRED IN PRODUCTION. The link the delivery partner's account executive
# issues: every "Order now" button on the site goes here, with a utm_campaign
# saying which button it was.
#
# Unset, the site shows the phone number instead of a dead button. That is the
# right behaviour and it is also the reason a typo here is quiet — check the
# buttons after you set it.
#
# Live since 24 Nov 2026, issued by the DoorDash account executive:
#   https://order.online/en/business/~1013632
#
# Note what that id is. 1013632 is the BUSINESS, which lists three stores, so
# the link opens a location chooser. The New Brunswick counter has its own
# store link that opens straight on its menu:
#   https://order.online/store/shahzad-s-halal-food-new-brunswick-25676460
# Only ever set one of these, and only in Vercel — it is public, not secret,
# but it belongs with the deployment rather than in the repository.
NEXT_PUBLIC_ORDER_URL=""

# --- Auth --------------------------------------------------------------------
# REQUIRED. Signs session tokens, one-time codes, hashed IPs and every
# unsubscribe link. Changing it signs everyone out, invalidates every
# outstanding code, and breaks unsubscribe links already sitting in inboxes —
# so production needs its own, generated once, and the development one must
# never travel.
# Generate with: openssl rand -base64 32
AUTH_SECRET=""

# --- Sending offers ----------------------------------------------------------
# REQUIRED IN PRODUCTION once there is a list. A send is a queue of rows worked
# through a batch at a time by /api/cron/offers, which a scheduler calls every
# minute (see vercel.json). This secret is how that route knows the caller is
# the scheduler: it has no session.
#
# Unset or shorter than 16 characters, the route refuses everybody and sends
# have to be nudged by hand from the offer's page. That is the right way round
# — an open endpoint that sends email is worse than a send that needs a tap.
# Generate with: openssl rand -base64 32
CRON_SECRET=""

# --- Later: texting ----------------------------------------------------------
# Not used yet, and nothing is texted. Marketing SMS to US numbers needs A2P
# 10DLC registration first, and this site will not send one until a number has
# been confirmed by a reply from the handset (Subscriber.smsConfirmedAt) — a
# ticked box proves somebody agreed, not that it was the person holding it.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_MESSAGING_SERVICE_SID=""

# --- Email ------------------------------------------------------------------
# Confirmation links, password resets and offers are sent from here.
#
# Leave RESEND_API_KEY empty in development: mail then goes to .mail/outbox.jsonl
# and `npm run mail -- --watch` prints the links, so the whole flow works
# offline. Set EMAIL_TRANSPORT to "outbox" or "resend" to force one either way.
EMAIL_TRANSPORT=""
RESEND_API_KEY=""
# Must be an address at a domain verified with the provider, with SPF, DKIM and
# DMARC in its DNS — or offers land in spam when they do not bounce.
RECEIPT_FROM_EMAIL="Shahzad's Halal Food <hello@example.com>"

# --- Seeding the first owner -------------------------------------------------
# There is no public sign-up: this is how the first account comes into being.
# SEED_OWNER_EMAIL is required when SEED_OWNER_PHONE is set — it is the login.
SEED_OWNER_EMAIL=""
SEED_OWNER_PHONE=""
SEED_OWNER_NAME=""
SEED_OWNER_PASSWORD=""
