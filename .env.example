# ---------------------------------------------------------------------------
# Copy to .env.local (Next.js) / .env (Prisma CLI) and fill in.
# NEVER commit a filled-in copy of this file.
# ---------------------------------------------------------------------------

# Postgres — matches docker-compose.yml for local development.
DATABASE_URL="postgresql://shahzad:shahzad@localhost:5432/shahzads?schema=public"

# Public base URL of the site (used for callbacks and absolute links).
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Phase 2: auth + OTP -----------------------------------------------------
# REQUIRED. Signs session tokens, one-time codes and hashed IPs. Changing it
# signs everyone out and invalidates every outstanding code.
# Generate with: openssl rand -base64 32
AUTH_SECRET=""

# How one-time codes reach people.
#   console (default) — printed to the server terminal and shown on the verify
#                       screen. Development only: a production build refuses to
#                       use it unless ALLOW_CONSOLE_SMS=1 is also set, which is
#                       only for the end-to-end tests.
#   twilio            — not implemented yet; SMS is on hold until the A2P 10DLC
#                       registration is approved.
SMS_PROVIDER="console"

# Twilio, once A2P 10DLC registration is approved (required for US SMS).
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_MESSAGING_SERVICE_SID=""

# --- Phase 4: payments -------------------------------------------------------
STRIPE_SECRET_KEY=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""

# --- Phase 4: email receipts -------------------------------------------------
RESEND_API_KEY=""
RECEIPT_FROM_EMAIL=""

# --- Phase 6: printing -------------------------------------------------------
# Shared secret the in-store printer/agent uses to poll for jobs.
PRINT_AGENT_TOKEN=""
