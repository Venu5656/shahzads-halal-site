# ---------------------------------------------------------------------------
# Copy to .env.local (Next.js) / .env (Prisma CLI) and fill in.
# NEVER commit a filled-in copy of this file.
# ---------------------------------------------------------------------------

# Postgres — matches docker-compose.yml for local development.
DATABASE_URL="postgresql://shahzad:shahzad@localhost:5432/shahzads?schema=public"

# Public base URL of the site (used for callbacks and absolute links).
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Auth --------------------------------------------------------------------
# REQUIRED. Signs session tokens, one-time codes and hashed IPs. Changing it
# signs everyone out and invalidates every outstanding code.
# Generate with: openssl rand -base64 32
AUTH_SECRET=""

# --- Later: texting ----------------------------------------------------------
# Not used yet. Accounts are phone + password and nothing is texted. These are
# for "your order is ready" messages, and for verifying phone numbers if that
# is ever switched on. US SMS needs A2P 10DLC registration first.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_MESSAGING_SERVICE_SID=""

# --- Phase 4: payments -------------------------------------------------------
STRIPE_SECRET_KEY=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""

# --- Email ------------------------------------------------------------------
# Verification and password-reset links are sent from here.
#
# Leave RESEND_API_KEY empty in development: mail then goes to .mail/outbox.jsonl
# and the link is printed to the terminal, so the whole flow works offline.
# Set EMAIL_TRANSPORT to "outbox" or "resend" to force one either way.
EMAIL_TRANSPORT=""
RESEND_API_KEY=""
# Must be an address at a domain verified with the provider, or mail will bounce.
RECEIPT_FROM_EMAIL="Shahzad's Halal Food <orders@example.com>"

# --- Phase 6: printing -------------------------------------------------------
# Shared secret the in-store printer/agent uses to poll for jobs.
PRINT_AGENT_TOKEN=""

# --- Seeding the first owner (optional) --------------------------------------
# SEED_OWNER_EMAIL is required when SEED_OWNER_PHONE is set: it is the login.
SEED_OWNER_EMAIL=""
SEED_OWNER_PHONE=""
SEED_OWNER_NAME=""
SEED_OWNER_PASSWORD=""
