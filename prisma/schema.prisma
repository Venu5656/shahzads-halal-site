// Shahzad's Halal Food — data model.
//
// Conventions enforced across this schema:
//   * Money is ALWAYS integer cents (Int). Never Float, never Decimal dollars.
//   * Every timestamp is stored in UTC and rendered in America/New_York.
//   * Anything shown on a past order is snapshotted onto the order, so editing
//     the menu can never rewrite history.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------- accounts

enum Role {
  CUSTOMER
  MANAGER
  OWNER
}

/// Somebody who works at the shop.
///
/// Not a customer. Customers have nothing to sign in for — ordering belongs to
/// the delivery platform, and anyone who wants offers joins a Subscriber,
/// which has no password at all. The CUSTOMER role survives as the default
/// only because an account created without one should be the least privileged
/// thing in the system, not the most.
model User {
  id              String    @id @default(cuid())
  name            String
  /// E.164, e.g. +17325551234. Unique, and how people log in.
  phone           String    @unique
  /// scrypt hash of the password. Null only for an invited manager who has not
  /// set one yet.
  passwordHash    String?
  /// Nothing proves the number yet — SMS verification is deferred. The flag is
  /// kept ready for when codes are switched on.
  phoneVerified   Boolean   @default(false)
  /// Required, unique, and the address every verification and password-reset
  /// link is sent to. Also where receipts go.
  email           String    @unique
  /// When the address was proved. Null means the account cannot log in yet.
  emailVerifiedAt DateTime?
  /// A new address the customer asked for, held until they prove it.
  pendingEmail    String?
  role            Role      @default(CUSTOMER)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  lastLoginAt     DateTime?

  sessions     Session[]
  emailTokens  EmailToken[]
  orders       Order[]
  cart         Cart?
  auditLogs    AuditLog[]    @relation("AuditActor")
  priceChanges PriceChange[]
  invitesSent  StaffInvite[] @relation("InviteCreatedBy")

  @@index([role])
}

/// A signed-in device. The browser holds a random token; only its SHA-256
/// lives here, so a database leak cannot be replayed as a login.
model Session {
  /// SHA-256 (hex) of the session token held in the cookie.
  id        String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
  userAgent String?
  /// HMAC of the sign-in IP — we never store raw addresses.
  ipHash    String?

  @@index([userId])
  @@index([expiresAt])
}

/// One row per login attempt, for rate limiting. Kept short-lived: anything
/// older than a day can be deleted.
model LoginAttempt {
  id         String   @id @default(cuid())
  /// What was typed in the identifier box — an email address or an E.164
  /// number — whether or not it has an account.
  identifier String
  /// HMAC of the requesting IP — we never store raw addresses.
  ipHash     String?
  success    Boolean
  createdAt  DateTime @default(now())

  @@index([identifier, createdAt])
  @@index([ipHash, createdAt])
}

enum EmailTokenPurpose {
  VERIFY_EMAIL
  RESET_PASSWORD
}

/// One row per emailed link. The link itself is never stored — only the
/// SHA-256 of its token — so a database dump cannot be used to verify an
/// address or reset a password. Single-use: `consumedAt` is set the moment a
/// token is spent, in the same transaction that acts on it.
model EmailToken {
  id         String            @id @default(cuid())
  /// SHA-256 (hex) of the token that travels in the link.
  tokenHash  String            @unique
  purpose    EmailTokenPurpose
  userId     String
  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// The address this link was sent to — kept so a token issued for an old
  /// address cannot verify a newer one.
  email      String
  expiresAt  DateTime
  consumedAt DateTime?
  /// HMAC of the requesting IP — we never store raw addresses.
  ipHash     String?
  createdAt  DateTime          @default(now())

  @@index([userId, purpose, createdAt])
  @@index([email, purpose, createdAt])
  @@index([expiresAt])
}

/// Pending invitation for a manager, redeemed on first login.
model StaffInvite {
  id          String    @id @default(cuid())
  phone       String
  role        Role
  createdById String
  createdBy   User      @relation("InviteCreatedBy", fields: [createdById], references: [id])
  acceptedAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  @@index([phone])
}

// --------------------------------------------------- the promotions list

/// Someone who asked to hear about offers.
///
/// Deliberately NOT a User. There is no password, no session and no role on
/// this model, so the list cannot be used to sign in at all — a leak of it is
/// a leak of addresses and nothing more. Accounts exist for the two or three
/// people who run the shop; this is the several thousand who want to know
/// about a deal.
model Subscriber {
  id               String    @id @default(cuid())
  /// Lower-cased. Unique, because the same address joining twice is the same
  /// person, not a second subscriber.
  email            String    @unique
  /// When they opened the confirmation link. Null means nothing has proved
  /// the address, and nothing is ever sent to it except that one link — a
  /// list built without double opt-in is a list of other people's typos.
  emailConfirmedAt DateTime?
  /// E.164. Optional, and deliberately NOT unique: a couple sharing one
  /// handset should both be able to join, and refusing the second one teaches
  /// the typist nothing they can act on.
  phone            String?
  /// Set only when the SMS box was ticked. Separate from the address because
  /// permission to text is a separate permission — in law and in fact. Null
  /// means they never agreed, whatever else they agreed to.
  smsConsentAt     DateTime?
  /// When the NUMBER was proved to belong to them, by replying to a
  /// confirmation text. Null for every row today, because the number cannot
  /// be proved until A2P 10DLC registration is through and we can send one.
  ///
  /// This column is the gate on sending, not smsConsentAt. The reason is the
  /// oldest hole in SMS marketing: anybody can type a stranger's number into
  /// a form and tick a box, and the stranger's carrier complaint lands on the
  /// sender. A ticked box proves somebody agreed; only a reply from the
  /// handset proves it was the person holding it.
  smsConfirmedAt   DateTime?
  /// Set when they stop it: a link, a STOP reply, or a word at the counter.
  /// Stopped rather than deleted, so a later send cannot re-add them by
  /// accident.
  emailStoppedAt   DateTime?
  smsStoppedAt     DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  tokens   SubscriberToken[]
  consents ConsentEvent[]

  @@index([emailConfirmedAt])
  @@index([phone])
}

/// One row per confirmation link sent to a subscriber. Same shape and the same
/// guarantees as EmailToken — only the SHA-256 of the token is stored, and
/// `consumedAt` is set in the transaction that acts on it — but kept separate
/// because a nullable foreign key pointing at either a user or a subscriber is
/// the kind of union that eventually confirms the wrong one.
model SubscriberToken {
  /// SHA-256 (hex) of the token that travels in the link.
  tokenHash    String     @id
  subscriberId String
  subscriber   Subscriber @relation(fields: [subscriberId], references: [id], onDelete: Cascade)
  /// The address this link was sent to, so a link issued for one address can
  /// never confirm another.
  email        String
  expiresAt    DateTime
  consumedAt   DateTime?
  createdAt    DateTime   @default(now())

  @@index([subscriberId, createdAt])
  @@index([expiresAt])
}

enum ConsentChannel {
  EMAIL
  SMS
}

enum ConsentAction {
  /// They ticked the box.
  GRANTED
  /// They proved the address by opening the link.
  CONFIRMED
  /// They stopped it.
  WITHDRAWN
}

/// The evidence that somebody agreed.
///
/// Append-only. Rows are written and never updated or deleted, and the
/// Subscriber columns beside them are only a cache of the latest state — the
/// state is what a send reads, this is what answers the question afterwards.
///
/// The question is specific. Under the TCPA the sender carries the burden of
/// proving consent, per message, at up to $1,500 each; "our database says
/// true" is not proof, because a boolean has no date, no wording and no
/// witness. A row that says this address, from this IP, in this browser, under
/// this wording, at this minute, is.
model ConsentEvent {
  id                String         @id @default(cuid())
  subscriberId      String
  subscriber        Subscriber     @relation(fields: [subscriberId], references: [id], onDelete: Cascade)
  channel           ConsentChannel
  action            ConsentAction
  /// The address or number this was about, as it stood at the time, so a
  /// later edit cannot rewrite what was agreed to.
  target            String
  /// The IP IN CLEAR — the one place in this schema that is.
  ///
  /// Every other IP here is an HMAC, because the only question asked of a
  /// login IP is whether it matches another one, and a hash answers that
  /// without keeping the address. A consent IP is read by a person deciding
  /// whether a consent was real, sometimes years later. A hash tells that
  /// person nothing, so storing one would be the appearance of evidence
  /// rather than evidence.
  ip                String?
  userAgent         String?
  /// Which wording was on the screen. The disclosure gets rewritten; the
  /// proof has to say which version they actually read.
  disclosureVersion String
  /// Where it happened: "join-form", "email-confirm", "unsubscribe-link",
  /// "sms-stop", "counter".
  source            String
  createdAt         DateTime       @default(now())

  @@index([subscriberId, channel, createdAt])
  @@index([channel, action, createdAt])
}

// -------------------------------------------------------------------- menu

enum ItemTag {
  HALAL
  VEGGIE
  SPICY
}

model Category {
  id        String     @id @default(cuid())
  name      String     @unique
  slug      String     @unique
  sortOrder Int        @default(0)
  isActive  Boolean    @default(true)
  items     MenuItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model MenuItem {
  id              String    @id @default(cuid())
  name            String
  slug            String    @unique
  description     String
  /// Path under /public, e.g. /img/combo-rice.webp
  imagePath       String
  /// NULL means "price not set yet" — such an item cannot be ordered.
  basePriceCents  Int?
  /// Merchandising label shown on the card, e.g. "Signature" or "Must-try".
  badge           String?
  /// Whether sales tax applies to this line. New Jersey taxes prepared food
  /// but exempts unflavoured bottled water, so taxability is per item rather
  /// than a single rate over the whole basket. Confirm the treatment of each
  /// with the accountant — see OPEN-QUESTIONS.md.
  isTaxable       Boolean   @default(true)
  categoryId      String
  category        Category  @relation(fields: [categoryId], references: [id])
  isAvailable     Boolean   @default(true)
  /// When set and in the future, the item is sold out until this instant.
  outOfStockUntil DateTime?
  sortOrder       Int       @default(0)
  isActive        Boolean   @default(true)
  tags            ItemTag[]
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  optionGroups MenuItemOptionGroup[]
  orderItems   OrderItem[]
  cartItems    CartItem[]
  priceChanges PriceChange[]

  @@index([categoryId, sortOrder])
}

/// e.g. "Sauce choice" (min 0, max 2, free) or "Extra meat" (+$3.00).
model OptionGroup {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  /// Minimum number of options the customer must pick.
  minSelect Int      @default(0)
  /// Maximum number of options the customer may pick.
  maxSelect Int      @default(1)
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  options Option[]
  items   MenuItemOptionGroup[]
}

model Option {
  id            String      @id @default(cuid())
  optionGroupId String
  optionGroup   OptionGroup @relation(fields: [optionGroupId], references: [id], onDelete: Cascade)
  name          String
  slug          String
  /// Surcharge in cents; 0 for free choices such as sauces.
  priceCents    Int         @default(0)
  isAvailable   Boolean     @default(true)
  sortOrder     Int         @default(0)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@unique([optionGroupId, slug])
}

/// Option groups attach to many items, and items have many groups.
model MenuItemOptionGroup {
  menuItemId    String
  menuItem      MenuItem    @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  optionGroupId String
  optionGroup   OptionGroup @relation(fields: [optionGroupId], references: [id], onDelete: Cascade)
  sortOrder     Int         @default(0)

  @@id([menuItemId, optionGroupId])
}

// -------------------------------------------------------------------- cart

/// Server-side cart for a signed-in customer. Guests keep theirs in
/// localStorage and it is merged into this one at sign-in.
model Cart {
  id        String     @id @default(cuid())
  userId    String     @unique
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model CartItem {
  id                String   @id @default(cuid())
  cartId            String
  cart              Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  menuItemId        String
  menuItem          MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  quantity          Int      @default(1)
  /// Chosen option ids, resolved and re-priced server-side at checkout.
  selectedOptionIds String[]
  note              String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([cartId])
}

// ------------------------------------------------------------------ orders

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  CONFIRMED
  PREPARING
  READY
  PICKED_UP
  CANCELLED
  REFUNDED
}

enum PaymentMethod {
  CARD
  APPLE_PAY
  GOOGLE_PAY
  PAYPAL
}

model Order {
  id          String      @id @default(cuid())
  /// Short human code shown to staff and customers, e.g. SH-4821.
  orderNumber String      @unique
  userId      String
  user        User        @relation(fields: [userId], references: [id])
  status      OrderStatus @default(PENDING_PAYMENT)

  subtotalCents Int
  taxCents      Int
  tipCents      Int @default(0)
  totalCents    Int
  refundedCents Int @default(0)

  paymentIntentId String?        @unique
  paymentMethod   PaymentMethod?
  stripeRefundId  String?

  /// Requested pickup time (NULL means ASAP).
  pickupAt     DateTime?
  customerNote String?

  /// Snapshot of who to call, so a later profile edit cannot change history.
  customerNameSnapshot  String
  customerPhoneSnapshot String

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  /// PENDING_PAYMENT orders are swept after this instant (30 minutes).
  expiresAt      DateTime?
  paidAt         DateTime?
  confirmedAt    DateTime?
  preparingAt    DateTime?
  readyAt        DateTime?
  pickedUpAt     DateTime?
  cancelledAt    DateTime?
  refundedAt     DateTime?
  printedAt      DateTime?
  /// Set when a manager has silenced the new-order alarm for this order.
  acknowledgedAt DateTime?
  /// Stamped once the receipt has gone out, so a retried webhook cannot send
  /// a second one.
  receiptSentAt  DateTime?

  items OrderItem[]

  @@index([status, createdAt])
  @@index([userId, createdAt])
}

model OrderItem {
  id         String    @id @default(cuid())
  orderId    String
  order      Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  /// Kept for analytics; nulled if the item is ever deleted from the menu.
  menuItemId String?
  menuItem   MenuItem? @relation(fields: [menuItemId], references: [id], onDelete: SetNull)

  nameSnapshot    String
  unitPriceCents  Int
  quantity        Int
  /// [{ groupName, optionName, priceCents }] as chosen at checkout time.
  selectedOptions Json     @default("[]")
  note            String?
  lineTotalCents  Int
  createdAt       DateTime @default(now())

  @@index([orderId])
}

// ------------------------------------------------------- store + audit trail

/// Single-row table (id = "store") holding operational switches.
model StoreSettings {
  id             String   @id @default("store")
  /// "Kitchen is slammed" — blocks all new orders when true.
  orderingPaused Boolean  @default(false)
  pausedMessage  String?
  /// Per-day overrides of today's hours, as { "2026-09-20": [10, 24] }.
  hoursOverrides Json     @default("{}")
  /// Sales tax rate in parts per million (6.625% = 66_250). PLACEHOLDER until
  /// the owner confirms the rate and whether listed prices include it.
  taxRatePpm     Int      @default(66250)
  updatedAt      DateTime @updatedAt
}

/// Every move a price has made, and who moved it.
///
/// Written in the same transaction as the price itself, so the history can
/// never drift from the number. It answers the question the owner actually
/// asks — "when did this go up, and did I change it here or only on the
/// ordering page" — which a column holding just the current value cannot.
model PriceChange {
  id            String   @id @default(cuid())
  menuItemId    String
  menuItem      MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  oldPriceCents Int?
  newPriceCents Int?
  /// Null once that account is gone. The relation cannot be required: a
  /// manager who has ever touched a price would then be undeletable, and
  /// "we cannot remove your login because you changed the gyro in March" is
  /// not a policy anybody chose.
  changedById   String?
  changedBy     User?    @relation(fields: [changedById], references: [id], onDelete: SetNull)
  /// The name as it stood, snapshotted the way an order snapshots its items.
  /// It is what keeps the history readable after the account goes, which is
  /// the whole point of keeping it.
  changedByName String
  createdAt     DateTime @default(now())

  @@index([menuItemId, createdAt])
}

/// Every manager action writes one of these.
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  action     String
  entityType String
  entityId   String
  oldValue   Json?
  newValue   Json?
  /// Hashed IP — we never store raw addresses.
  ipHash     String?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId, createdAt])
  @@index([actorId, createdAt])
}

/// Stripe webhook de-duplication: an event id is processed at most once.
model WebhookEvent {
  id          String   @id
  type        String
  processedAt DateTime @default(now())
}
